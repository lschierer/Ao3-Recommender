{
	"folders":
	[
		{
			"path": "."
		}
	],
	"settings" : {
        "draw_white_space": "all",
                    "translate_tabs_to_spaces": true,
        "syntax_override": {
            "\\.md$": {
                "syntax": "Packages/Markdown/Markdown.sublime-syntax",
                "settings": {
                    "tab_size": 2,
                }
            },
        },
        "linters": {
            "htmltidy": {
              "selector": "text.html"
          },
      },
      "LSP" : {
        "LSP-eslint" : {
            "enabled" : true, "settings" : { "useFlatConfig" : true, }
        },
        "LSP-cspell" : {
            "selector": "text.html.markdown | source.yaml",
            "settings" : {
                "cSpell.enabled"      : true,
                "cSpell.showStatus"   : true,
                "cSpell.useGitignore" : true,
                "cSpell.diagnosticLevel" : "Warning",
            }
        }
    },
},
"required_packages" : [
    "BracketHighlighter",
    "Dictionary",
    "Dockerfile Syntax Highlighting",
    "EditorConfig",
    "FileManager",
    "Google Dictionary",
    "LSP",
    "LSP-eslint",
    "LSP-json",
    "LSP-typescript",
    "LSP-cspell",
    "Markdown Extended",
    "MarkdownFootnotes",
    "MarkdownPreview",
    "NeoVintageous",
    "Package Control",
    "Project Specific Syntax Settings",
    "SideBarEnhancements",
],
}
